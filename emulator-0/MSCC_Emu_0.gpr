with "SDL3.gpr";
project MSCC_Emu_0 is
   for Languages    use ("Ada", "C");
   for Source_Dirs use ("src/**", "top");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("main.c");

   CFLAGS := External_As_List("CFLAGS", " ");
   LDFlAGS := External_As_List("LDFLAGS", " ");

   package Builder is
   end Builder;

   package Compiler is
      C_Switches := CFLAGS & ("-pedantic", "-Wall", "-ggdb");
      for Default_Switches ("C")   use C_Switches;
      for Default_Switches ("Ada") use ("-gnat2022");
   end Compiler;

   package Binder is
   end Binder;

   package Linker is
      for Leading_Switches ("C") use LDFLAGS;
   end Linker;
end MSCC_Emu_0;