project MSCC_Emu_0 is
   for Languages    use ("Ada", "C");
   for Source_Dirs use ("src/**", "top");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("main.c");

   package Builder is
   end Builder;

   package Compiler is
      C_Switches := ("-pedantic", "-Wall", "-ggdb");
      for Default_Switches ("C")   use C_Switches;
      for Default_Switches ("Ada") use ("-gnat2022");
   end Compiler;

   package Binder is
   end Binder;

   package Linker is
      for Default_Switches ("C") use ("-lSDL3");
   end Linker;
end MSCC_Emu_0;